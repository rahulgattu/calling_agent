# Copy this file to .env and fill in the provider values.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# School-specific prompt context is maintained in principal_context.md.
GROQ_MODEL=openai/gpt-oss-120b

# Phase 2: Twilio phone calls (inbound). Get these from the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
